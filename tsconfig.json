{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "@components/*": ["src/components/*"],
      "@ui/*": ["src/components/ui/*"],
      "@features/*": ["src/features/*"],
      "@core/*": ["src/core/*"],
      "@state/*": ["src/state/*"],
      "@assets/*": ["assets/*"],
    }
  }
}
